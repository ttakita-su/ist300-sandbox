# Environment for the production Next.js build described in docs/PLAN.md.
# The prototype in this folder reads none of these. Its local server (npm start, backend/) reads
# only PORT and HOST from the real environment (or --port / --host); it never loads this file
# or any .env file, and it holds no keys.
#
# Copy to .env.local for local work and set real values in the hosting provider's settings.
# Never commit real values. Variables starting with NEXT_PUBLIC_ are sent to the browser;
# every other variable is server-only and must never be imported by client code.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Public base URL of the app, used for auth redirects and outbound links.
NEXT_PUBLIC_SITE_URL=

# Shared secret that scheduled jobs (Vercel cron) send, so job routes refuse other callers.
# Server-only.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Supabase (Auth, Postgres, Storage, Queues)
# ---------------------------------------------------------------------------

# Project URL, from Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Anon (publishable) key. Safe in the browser: row-level security applies to every request.
# Supabase's newer publishable key can be used in its place.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (secret) key, server-only. It bypasses row-level security, so use it only for
# writes no person may make directly (match results, evidence, clicks, conversions, metrics).
# Supabase's newer secret key can be used in its place.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string through the pooler, for writes that must be one
# transaction (confirming a match, marking a wish purchased). Server-only.
SUPABASE_DB_URL=

# Project ref and a personal access token for the Supabase CLI in CI (supabase link,
# supabase db push). CI-only; never deployed with the app.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Storage bucket names created by supabase/migrations/0002_storage.sql:
# user-photos, catalog-assets and catalog-restricted.
STORAGE_BUCKET_USER_PHOTOS=
STORAGE_BUCKET_CATALOG_PUBLIC=
STORAGE_BUCKET_CATALOG_RESTRICTED=

# Lifetime in seconds of signed photo URLs. Keep it short (60 to 300): a signed URL can't be
# revoked, so this bounds how long a revoked stylist share can still load a photo.
STORAGE_SIGNED_URL_TTL_SECONDS=

# Auth emails are sent through the SMTP provider configured in Supabase (Authentication >
# Emails), not through variables here.

# ---------------------------------------------------------------------------
# Anthropic (candidate verification, label reading, request parsing)
# ---------------------------------------------------------------------------

# API key. Server-only.
ANTHROPIC_API_KEY=

# Model ids chosen after Milestone 1, such as claude-opus-5-5, claude-sonnet-5-5 or
# claude-haiku-4-5 (docs/providers.md).
ANTHROPIC_MODEL_MATCH=
ANTHROPIC_MODEL_PARSE=

# Monthly spend limit in USD that the app enforces on its own model calls.
AI_MONTHLY_BUDGET_USD=

# ---------------------------------------------------------------------------
# Image embeddings for visual retrieval: set one provider
# ---------------------------------------------------------------------------

# google, aws or azure.
EMBEDDING_PROVIDER=

# Model name stored with each vector, such as multimodalembedding@001. Changing it means
# re-embedding the catalog (supabase/README.md).
EMBEDDING_MODEL=

# Google Cloud (Gemini Enterprise Agent Platform, formerly Vertex AI). The service account key
# is server-only; prefer workload identity federation where the host supports it.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Amazon Bedrock, if chosen instead. Server-only.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Vision, if chosen instead. Server-only.
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# ---------------------------------------------------------------------------
# Affiliate networks (product feeds, tracked links, conversion reports). All server-only.
# ---------------------------------------------------------------------------

# Rakuten Advertising: API credentials, the site id links are built for, and the SFTP account
# that delivers Product Catalog feeds.
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_SITE_ID=
RAKUTEN_SFTP_USER=
RAKUTEN_SFTP_PASSWORD=

# CJ: personal access token, company id (CID) and the website id (PID) links are built for.
CJ_PERSONAL_ACCESS_TOKEN=
CJ_COMPANY_ID=
CJ_WEBSITE_ID=

# Impact: partner account SID and auth token.
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# Awin: publisher id, Publisher API token, and the separate data feed API key.
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
AWIN_FEED_API_KEY=

# ---------------------------------------------------------------------------
# Barcode and GTIN lookups (optional). Server-only.
# ---------------------------------------------------------------------------

GS1_US_DATAHUB_API_KEY=
UPCITEMDB_USER_KEY=
