# Twisted Takes uses the same gem set that GitHub Pages builds with.
# GitHub Pages ignores this file on its servers; it exists so a local preview
# matches the live build. See README.md, "Preview locally".
source "https://rubygems.org"

# Pins Jekyll and every plugin to the versions GitHub Pages runs.
# Update with: bundle update github-pages
gem "github-pages", group: :jekyll_plugins

# `jekyll serve` needs a web server gem on Ruby 3.0 and newer.
gem "webrick", "~> 1.8"

# Windows has no built-in timezone database; Jekyll needs one for `timezone:`.
platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
