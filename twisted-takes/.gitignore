# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Local gem installs (bundle config set --local path vendor/bundle)
.bundle/
vendor/

# The lockfile is platform-specific (macOS, Windows and Linux resolve
# different native gems). GitHub Pages ignores it, so it is not committed.
Gemfile.lock

# Optional tool dependencies (tools/package.json)
node_modules/

.DS_Store
