---
layout: null
permalink: /search.json
sitemap: false
---
{%- comment -%}
  Search index for the Reviews page. Every value goes through jsonify, so
  quotes, apostrophes and line breaks in titles or text cannot break the JSON.
  URLs already include the base path.
{%- endcomment -%}
{%- assign tt_docs = site.reviews | concat: site.posts | concat: site.watch_next -%}
[
{%- for doc in tt_docs %}
  {%- if doc.collection == "reviews" -%}{%- assign tt_kind = "review" -%}{%- elsif doc.collection == "posts" -%}{%- assign tt_kind = "article" -%}{%- else -%}{%- assign tt_kind = "collection" -%}{%- endif %}
  {
    "kind": {{ tt_kind | jsonify }},
    "title": {{ doc.title | jsonify }},
    "headline": {{ doc.headline | default: doc.title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "excerpt": {{ doc.excerpt | strip_html | normalize_whitespace | jsonify }},
    "year": {{ doc.year | jsonify }},
    "media_type": {{ doc.media_type | jsonify }},
    "genre": {{ doc.primary_genre | jsonify }},
    "tags": {{ doc.tags | jsonify }},
    "moods": {{ doc.moods | jsonify }},
    "director": {{ doc.director | jsonify }},
    "date": {{ doc.date | date: "%Y-%m-%d" | jsonify }},
    "text": {{ doc.content | strip_html | normalize_whitespace | truncatewords: 150, "" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
