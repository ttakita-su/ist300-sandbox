{
  "manifest_version": 3,
  "name": "Free Bet Blackjack Advisor",
  "short_name": "Free Bet",
  "version": "0.1.0",
  "description": "Type your cards and the dealer's upcard to see the Free Bet Blackjack basic-strategy play. Advice only; it never reads web pages.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open the Free Bet advisor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
